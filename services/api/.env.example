SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # service_role / secret key — backend only, never in frontend
SUPABASE_JWT_SECRET=          # only for legacy HS256 projects (JWKS is used otherwise)
DATABASE_URL=                 # Session pooler URI; empty = local SQLite offline mode (services/api/janavaani.db)
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-flash-latest
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GEMINI_TTS_MODEL=
GROQ_API_KEY=
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
ALLOWED_ORIGINS=http://localhost:5173
DEMO_MODE=true
AI_CACHE_DIR=.ai_cache
APP_JWT_SECRET=               # signs DEMO_MODE tokens (e.g. openssl rand -hex 32); empty = random per restart. Also salts guest PINs: changing it needs a re-seed
PUBLIC_API_URL=               # base of photo links; empty = SPACE_HOST on Hugging Face, else the request host
AUTO_SEED=false               # true = seed the demo city at startup when an empty SQLite database is in use
ALLOW_DEMO_LOGIN=false        # true = /auth/demo-login stays open while Supabase is configured (outage fallback only)
FORCE_FAIL_GEMINI=false
FORCE_FAIL_GROQ=false
